+});
+
+describe("windowTitleFor", () => {
+  test("names the engagement and the verified count", () => {
+    expect(windowTitleFor(statusBase)).toBe("ARDENT · acme · 2 verified");
+    expect(windowTitleFor({ ...statusBase, verified: 0 })).toBe("ARDENT · acme");
