+        ctx.ui.setWorkingIndicator({ frames: workingFrames(theme), intervalMs: WORKING_FRAME_MS });
+      } else {
+        ctx.ui.setWorkingIndicator(undefined);
+      }
+    } catch {
+      // best-effort UI
+    }
