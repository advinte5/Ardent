+        },
+        async execute(_toolCallId, params) {
+          if (!engaged()) return evidenceGated();
+          const result = state.evidence.addRelation({
+            from: params.from,
+            to: params.to,
+            kind: params.kind as RelationKind,
+            ...(params.note === undefined ? {} : { note: params.note }),
+          });
