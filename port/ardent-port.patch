+        if (ctx.hasUI) {
+          try {
+            ctx.ui.setWidget(ARDENT_IDLE_WIDGET_KEY, undefined);
+          } catch {
+            // best-effort UI
+          }
+        }
+        if (ctx.hasUI) {
+          try {
+            ctx.ui.setWorkingIndicator(undefined);
+          } catch {
+            // best-effort UI
+          }
+        }
+        if (ctx.hasUI) {
+          try {
+            ctx.ui.setStatus("ardent", undefined);
+          } catch {
+            // best-effort UI
+          }
+        }
+        if (ctx.hasUI) {
+          try {
+            ctx.ui.setWorkingMessage(undefined);
+          } catch {
+            // best-effort UI
+          }
+        }
