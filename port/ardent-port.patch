+          addFact(state.memory, `${target.host}: captured ${artifact.id}`);
+          addTodo(
+            state.memory,
+            `Cite ${artifact.id} from a finding or observation: ${params.description}`,
+          );
+          pi.appendEntry("ardent-memory", state.memory);
